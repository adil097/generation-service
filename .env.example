# Local development values. Copy to .env; do not commit real secrets.
DATABASE_URL=postgresql+asyncpg://generation:local-development@localhost:5432/generation
ALPHA_URL=http://alpha:8000
BETA_URL=http://beta:8000
ALPHA_WEBHOOK_SECRET=local-alpha-secret
BETA_WEBHOOK_SECRET=local-beta-secret
PAYMENTS_WEBHOOK_SECRET=local-payments-secret

# Seconds. Required: HTTP_TIMEOUT < DISPATCH_LEASE < PROVIDER_TIMEOUT.
HTTP_TIMEOUT=5
DISPATCH_LEASE=15
PROVIDER_TIMEOUT=60
POLL_INTERVAL=1
