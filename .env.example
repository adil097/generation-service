# Local development values. Copy to .env; do not commit real secrets.
POSTGRES_DB=generation
POSTGRES_USER=generation
POSTGRES_PASSWORD=local-development
POSTGRES_PORT=55432
API_PORT=8000
MIGRATION_DATABASE_PASSWORD=local-migration-password
APP_DATABASE_PASSWORD=local-app-password
PROVIDER_DATABASE_PASSWORD=local-provider-password

# For Python running on the host. Compose sets the internal database address.
DATABASE_URL=postgresql+asyncpg://generation_app:local-app-password@localhost:55432/generation
ALPHA_URL=http://alpha:8000
BETA_URL=http://beta:8000
CALLBACK_BASE_URL=http://api:8000
ALPHA_WEBHOOK_SECRET=local-alpha-secret
BETA_WEBHOOK_SECRET=local-beta-secret
PAYMENTS_WEBHOOK_SECRET=local-payments-secret

# Seconds. Required: HTTP_TIMEOUT < DISPATCH_LEASE < PROVIDER_TIMEOUT.
HTTP_TIMEOUT=5
DISPATCH_LEASE=15
PROVIDER_TIMEOUT=60
POLL_INTERVAL=1

# Fake-provider scenarios. ALPHA_* and BETA_* are independent Compose controls.
# Direct Python launch uses the same names without ALPHA_/BETA_ prefixes,
# plus PROVIDER_NAME, PROVIDER_WEBHOOK_SECRET and a provider-role DATABASE_URL.
ALPHA_FAILURE_RATE=0
ALPHA_FAILURE_TYPE=technical
ALPHA_SYNC_MODE=none
ALPHA_RESPONSE_DELAY=10
ALPHA_DELAY_MIN=2
ALPHA_DELAY_MAX=20
ALPHA_DUPLICATE_WEBHOOK=false
ALPHA_CONCURRENT_DUPLICATES=false
ALPHA_NO_WEBHOOK=false
ALPHA_LATE_COMPLETED=false
ALPHA_LATE_DELAY=65
ALPHA_WEBHOOK_TIMEOUT=5
ALPHA_DELIVERY_LEASE=15
ALPHA_RETRY_INTERVAL=5
ALPHA_POLL_INTERVAL=1

BETA_FAILURE_RATE=0
BETA_FAILURE_TYPE=technical
BETA_SYNC_MODE=none
BETA_RESPONSE_DELAY=10
BETA_DELAY_MIN=2
BETA_DELAY_MAX=20
BETA_DUPLICATE_WEBHOOK=false
BETA_CONCURRENT_DUPLICATES=false
BETA_NO_WEBHOOK=false
BETA_LATE_COMPLETED=false
BETA_LATE_DELAY=65
BETA_WEBHOOK_TIMEOUT=5
BETA_DELIVERY_LEASE=15
BETA_RETRY_INTERVAL=5
BETA_POLL_INTERVAL=1
